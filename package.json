{
  "name": "3d-car-viewing",
  "version": "0.4.0",
  "description": "Browser 3D car showroom: GLB rig discovery, doors, lights, paint, and studio, hall, or highway venues. Next.js, React Three Fiber, and Three.js. MIT source code.",
  "license": "MIT",
  "author": "jiaxiantao",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiaxiantao/3d-car-viewing.git"
  },
  "bugs": {
    "url": "https://github.com/jiaxiantao/3d-car-viewing/issues"
  },
  "homepage": "https://jiaxiantao.github.io/3d-car-viewing/",
  "keywords": [
    "threejs",
    "react-three-fiber",
    "gltf",
    "glb",
    "3d",
    "car",
    "showroom",
    "car-viewer",
    "vehicle-configurator",
    "nextjs",
    "webgl",
    "draco"
  ],
  "engines": {
    "node": ">=20",
    "yarn": ">=1.22.0 <2"
  },
  "scripts": {
    "postinstall": "node scripts/apply-fiber-patch.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-gh-pages.mjs",
    "start": "node .next/standalone/server.js",
    "start:ci": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "compress:models": "node scripts/compress-market-glbs.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "9.8.1",
    "clsx": "^2.1.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^5.0.1",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "@react-three/fiber@9.8.1": "patches/@react-three__fiber@9.8.1.patch"
    }
  }
}
