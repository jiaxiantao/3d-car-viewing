# Copy to .env for local development (never commit .env).
# Public vars are embedded in the client bundle at build time.

# Canonical site URL (metadata, optional OG / sitemap integrations)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional OpenAI-compatible model for the showroom assistant.
# Read only by the local / standalone server. Do not prefix these with NEXT_PUBLIC_.
# Leave AI_API_KEY blank to type the key into the AI panel instead.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
